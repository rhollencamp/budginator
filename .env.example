# Copy to `.env` and fill in from your Supabase project's API settings.
#
# Both of these are baked into the bundle at build time and are meant to be
# public: the publishable key identifies the project, and Row Level Security is
# what actually guards the data. Never put a secret key here — those bypass RLS.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
