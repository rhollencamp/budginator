# Copy to `.env` and fill in from your Supabase project's API settings.
#
# Both of these are baked into the bundle at build time and are meant to be
# public: the anon key identifies the project, and Row Level Security is what
# actually guards the data. Never put the service-role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
